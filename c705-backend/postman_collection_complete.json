{
  "info": {
    "name": "C705 API - Complete Collection",
    "description": "Complete API collection for testing all C705 backend endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Base URL for the API. Default: http://localhost:3000"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token (automatically saved after login/signup)"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string",
      "description": "User ID (automatically saved after login/signup)"
    },
    {
      "key": "trackId",
      "value": "",
      "type": "string",
      "description": "Track ID (automatically saved after upload)"
    },
    {
      "key": "artistId",
      "value": "",
      "type": "string",
      "description": "Artist ID (set manually or from user response)"
    },
    {
      "key": "commentId",
      "value": "",
      "type": "string",
      "description": "Comment ID (set manually)"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Check if the server is running and healthy"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.access_token);",
                  "    pm.collectionVariables.set('userId', jsonData.user.id);",
                  "    pm.collectionVariables.set('artistId', jsonData.user.id);",
                  "    console.log('✅ Token saved:', jsonData.access_token);",
                  "    console.log('✅ User ID saved:', jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"artist@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"ARTIST\",\n  \"username\": \"TestArtist\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            },
            "description": "Sign up a new user. Token and User ID will be automatically saved.\n\nRoles: ARTIST, PRODUCER, ENGINEER, JOURNALIST, ADMIN"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.access_token);",
                  "    pm.collectionVariables.set('userId', jsonData.user.id);",
                  "    pm.collectionVariables.set('artistId', jsonData.user.id);",
                  "    console.log('✅ Token saved:', jsonData.access_token);",
                  "    console.log('✅ User ID saved:', jsonData.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"artist@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login with email and password. Token and User ID will be automatically saved."
          }
        },
        {
          "name": "OAuth - Apple Sign In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"apple\",\n  \"identityToken\": \"test-token-here\",\n  \"email\": \"user@example.com\",\n  \"fullName\": \"John Doe\",\n  \"role\": \"ARTIST\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/oauth/apple",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "oauth", "apple"]
            },
            "description": "Sign in with Apple. Replace identityToken with actual Apple identity token."
          }
        },
        {
          "name": "OAuth - Google Sign In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"google\",\n  \"identityToken\": \"test-token-here\",\n  \"email\": \"user@example.com\",\n  \"fullName\": \"John Doe\",\n  \"role\": \"ARTIST\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/oauth/google",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "oauth", "google"]
            },
            "description": "Sign in with Google. Replace identityToken with actual Google ID token."
          }
        }
      ]
    },
