    {
      "name": "Tracks",
      "item": [
        {
          "name": "Upload Track",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('trackId', jsonData.id);",
                  "    console.log('✅ Track ID saved:', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select an audio file (MP3, WAV, M4A, etc.)"
                },
                {
                  "key": "title",
                  "value": "My Test Song",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/tracks/upload",
              "host": ["{{baseUrl}}"],
              "path": ["tracks", "upload"]
            },
            "description": "Upload an audio track. Requires ARTIST or ADMIN role.\n\n⚠️ IMPORTANT: Change the 'file' field type from 'Text' to 'File' and select an audio file."
          }
        },
